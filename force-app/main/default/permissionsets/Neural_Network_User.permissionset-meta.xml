<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <applicationVisibilities>
        <application>Neural_Network</application>
        <visible>true</visible>
    </applicationVisibilities>
    <description>Grants access to the Neural Network application, visualizer tab, and NN_Log__c object for tracking training activity.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Neural Network User</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>NN_Log__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NN_Log__c.Action__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NN_Log__c.Epochs__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NN_Log__c.Final_Loss__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NN_Log__c.Learning_Rate__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NN_Log__c.Timestamp__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>NN_Log__c.User__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <tabSettings>
        <tab>NN_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Neural_Network_Visualizer</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
